<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de la fenêtre pendant le démarrage du process, réglage système en
         mode clair. Parent passé de Theme.Light à Theme.Black : l'app n'a pas
         de variante claire, le fond système clair était visible le temps du
         démarrage. Identique à values-night/styles.xml, volontairement. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- ?android:colorBackground suivait le thème système : fond clair
             derrière l'UI Flutter en mode jour. -->
        <item name="android:windowBackground">@color/happyn_background</item>
    </style>
</resources>
