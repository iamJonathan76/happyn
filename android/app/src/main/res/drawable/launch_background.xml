<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran de démarrage natif, affiché avant la première frame de Flutter.
  Le template Flutter posait @android:color/white ici : sur une app entièrement
  sombre, cela donnait un flash blanc à chaque démarrage à froid.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/happyn_background" />

    <item
        android:drawable="@drawable/happyn_mark"
        android:gravity="center" />
</layer-list>
