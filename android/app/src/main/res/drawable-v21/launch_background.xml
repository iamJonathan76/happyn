<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante API 21+. Le template posait ?android:colorBackground, qui suit le
  thème système et virait donc au clair en mode jour. L'app étant sombre en
  toutes circonstances, on force la même couleur que la variante de base.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/happyn_background" />

    <item
        android:drawable="@drawable/happyn_mark"
        android:gravity="center" />
</layer-list>
